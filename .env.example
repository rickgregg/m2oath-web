# M2Oath hosted web development environment
#
# Copy to .env for local development.
# Never commit real secrets.

# ---------------------------------------------------------
# Developer Application — OIDC
# ---------------------------------------------------------

# Auth0 domain, without https://
# Example:
# YOUR_TENANT.us.auth0.com
NUXT_OAUTH_AUTH0_DOMAIN=

# Auth0 application/client identifier.
NUXT_OAUTH_AUTH0_CLIENT_ID=

# Server-only Auth0 client secret.
NUXT_OAUTH_AUTH0_CLIENT_SECRET=

# Secret used to protect the Developer application's
# server-side authenticated session.
#
# Use a long, random value in real environments.
# nuxt-auth-utils requires at least 32 characters.
NUXT_SESSION_PASSWORD=

# ---------------------------------------------------------
# Existing Developer → Control Plane development seam
# ---------------------------------------------------------
#
# Temporary credential retained during the Phase 8 migration.
# Registration will continue to use this until the authenticated
# Developer session is connected to the control-plane boundary.
NUXT_DEVELOPER_TOKEN=
