{
  "name": "@m2oath/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "./test-integration.sh",
    "test:integration:vitest": "vitest run --no-file-parallelism test/*.integration.test.ts"
  },
  "dependencies": {
    "@m2oath/agent": "file:../../../m2oath-agent/packages/agent",
    "@m2oath/auth-jwt": "file:../../../m2oath-agent/packages/auth-jwt",
    "@m2oath/control-plane-client": "workspace:*",
    "@m2oath/persistence": "file:../../../m2oath-agent/packages/persistence",
    "@m2oath/sdk": "file:../../../m2oath-agent/packages/sdk",
    "@m2oath/persistence-mysql": "file:../../../m2oath-agent/packages/persistence-mysql"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "jose": "^6.2.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
